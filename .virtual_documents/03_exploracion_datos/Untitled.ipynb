


import pandas as pd
import os





archivos = os.listdir('../02_datos/01_crudos')
i = 0 # Inicializamos para contar los datasets
for archivo in archivos:
    i += 1
    print(f'{i}. {archivo}')





df_customers = pd.read_csv('../02_datos/01_crudos/olist_customers_dataset.csv')
df_geolocation = pd.read_csv('../02_datos/01_crudos/olist_geolocation_dataset.csv')
df_orders = pd.read_csv('../02_datos/01_crudos/olist_orders_dataset.csv')
df_order_items = pd.read_csv('../02_datos/01_crudos/olist_order_items_dataset.csv')
df_order_payments = pd.read_csv('../02_datos/01_crudos/olist_order_payments_dataset.csv')
df_order_reviews = pd.read_csv('../02_datos/01_crudos/olist_order_reviews_dataset.csv')
df_products = pd.read_csv('../02_datos/01_crudos/olist_products_dataset.csv')
df_sellers = pd.read_csv('../02_datos/01_crudos/olist_sellers_dataset.csv')
df_category_name = pd.read_csv('../02_datos/01_crudos/product_category_name_translation.csv')





tabla_archivos = {
    'customers': df_customers,
    'geolocation': df_geolocation,
    'orders': df_orders,
    'order_items': df_order_items,
    'order_payments': df_order_payments,
    'order_reviews': df_order_reviews,
    'products': df_products,
    'sellers': df_sellers,
    'category_name': df_category_name
}





for nombre, df in tabla_archivos.items():
    print(f'\n\n{nombre.upper()}: ')
    print(f'{df.info()}')






